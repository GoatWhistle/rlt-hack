# Переменные локального запуска через Docker Compose.
# Скопируйте файл в `.env` и меняйте значения под себя: `.env` в Git не попадает.
# Пустое значение означает «использовать значение по умолчанию из docker-compose.yml».

# --- Фронтенд ---
# Порт фронтенда на хосте.
WEB_PORT=8080
# Базовый URL API, подставляется при сборке.
VITE_API_BASE_URL=/api

# --- ClickHouse ---
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.9
# Порты хранилища на хосте: HTTP и нативный протокол.
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=supplier_search
# true — подключаться к ClickHouse по TLS. Для локального запуска не нужно.
CLICKHOUSE_SECURE=false
# Сколько соединений с ClickHouse API держит для параллельных запросов поиска.
CLICKHOUSE_POOL_SIZE=4
# Сколько потоков ClickHouse выделяет одному запросу; 0 — значение сервера.
CLICKHOUSE_MAX_THREADS=4
# Таймаут ответа ClickHouse для API, секунды; max_execution_time выводится из таймаутов поиска и закупки.
CLICKHOUSE_API_QUERY_TIMEOUT=15
# max_memory_usage запросов API, байты; 0 — значение сервера.
CLICKHOUSE_API_MAX_MEMORY_USAGE=0

# --- Веб-интерфейс ClickHouse ---
CLICKHOUSE_UI_IMAGE=ghcr.io/caioricciuti/ch-ui:v2.14.1
# Порт интерфейса на хосте: http://localhost:3488
CLICKHOUSE_UI_PORT=3488
# Адрес ClickHouse для интерфейса. Доступ передаётся внутри URL:
# у ch-ui нет отдельных переменных для пользователя и пароля.
CLICKHOUSE_UI_URL=http://${CLICKHOUSE_USER}:${CLICKHOUSE_PASSWORD}@clickhouse:8123

# --- Джоба сбора: источники ---
# Каждый адаптер включается своим флагом, обходятся только включённые.
# Адаптер исходного CSV: требует загруженных данных Git LFS в `task/data`.
# На рабочем компьютере данные не выгружаются, поэтому адаптер выключен.
SUPPLIER_DATASET_PROVIDER=false
# Фильтр по региону в исходном CSV, пусто — без фильтра.
SUPPLIER_DATASET_REGION=
# Путь к CSV поставщиков. Пусто — файл берётся из каталога данных задачи.
SUPPLIER_DATASET_PATH=
# YML-фиды магазинов: адреса через запятую, на каждый адрес — свой адаптер.
YML_FEED_PROVIDER=true
SUPPLIER_FEED_URLS=https://globalclimat.com/yandex.xml,https://sibrtex.ru/yandex.xml
# Сайты с разметкой schema.org: адреса через запятую, обход идёт по их sitemap.
SCHEMA_ORG_WEB_PROVIDER=true
SUPPLIER_SITE_URLS=https://kdom.ru,https://ninel-tex.ru,https://ateks-group.ru
# Каталоги компаний: адреса карточек адаптеры берут из sitemap источника.
OPTKATALOG_WEB_PROVIDER=true
ABOUTPARTNER_WEB_PROVIDER=true
TEXZAKAZ_WEB_PROVIDER=true
PULSCEN_WEB_PROVIDER=false
PULSCEN_DELAY_SECONDS=10
PULSCEN_SNAPSHOT_PATH=
GISP_REGISTRY_PROVIDER=false
# Пусто — полный обход открытых JSON-страниц производителей и продукции.
# Дополнительно можно указать полный XLSX-экспорт: HTTPS или file:///data/gisp/export.xlsx.
# Локальный файл нужно разместить вне Git и смонтировать в sync-job отдельно.
GISP_EXPORT_LOCATION=
PRODUCTCENTER_WEB_PROVIDER=false
PRODUCTCENTER_MAX_CARDS=0
# Темп ProductCenter отделён от остальных источников; 1 запрос в секунду.
PRODUCTCENTER_PARALLEL_REQUESTS=1
PRODUCTCENTER_REQUEST_INTERVAL=1
# Временный отказ соединения пережидается ограниченное число раз.
PRODUCTCENTER_CONNECTION_RETRIES=180
# В Docker Compose это отдельный именованный том; локально задайте путь вне Git.
PRODUCTCENTER_CACHE_DIR=/data/productcenter-cache
# Supl.biz: товары и продавцы по sitemap. Каталог на миллионы страниц, поэтому
# выключен: полный обход неполным не публикуется, лимит ниже только диагностический.
SUPL_BIZ_WEB_PROVIDER=false
# Диагностический лимит товаров: при большем числе в sitemap обход завершается ошибкой.
SUPL_BIZ_MAX_CARDS=0

# --- Джоба сбора: ограничения запуска ---
# Сколько источников обходится одновременно.
SYNC_PARALLEL_SOURCES=4
# Сколько запросов к одному источнику выполняет его адаптер одновременно.
SYNC_PARALLEL_REQUESTS=4
# Пачка записи в ClickHouse и размер порции собранного пакета. Ограничитель —
# число частей таблицы, а не память: на строку уходит около 0,9 КиБ, поэтому
# пачка 5000 держит под 5 МиБ. Список идентификаторов делится внутри запроса.
SYNC_WRITE_BATCH=5000
# Порция потокового адаптера: как часто результат попадает в хранилище во время
# обхода и сколько работы теряет обрыв. Собранный пакет делится по
# SYNC_WRITE_BATCH, а не по этому значению.
SYNC_BATCH_SIZE=32
# Сколько карточек берёт с одного источника один обход: каталоги публикуют тысячи.
SYNC_MAX_CARDS=500
# Пауза между циклами обхода в режиме демона.
SYNC_INTERVAL_SECONDS=3600
# Таймаут HTTP-запроса к источнику, секунды.
REQUEST_TIMEOUT=30
# Каталог справочников ОКПД2, рубрик, словаря, разделов каталогов и ОКЕИ.
# По умолчанию — backend/reference в репозитории или /app/reference в образе.
REFERENCE_DIR=
# Канал переноса кода ОКПД2 из архива закупок по совпадению названия.
# Пока архив не загружен в ClickHouse, канал ничего не находит и ничего не стоит.
CLASSIFIER_ARCHIVE_CHANNEL=true
# Сколько строк архива читается в индекс соответствия названий кодам.
CLASSIFIER_ARCHIVE_LIMIT=500000
# DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Накопление батча эмбеддингов (1–32), максимальное ожидание хвоста в секундах.
EMBEDDING_BATCH_SIZE=16
EMBEDDING_BATCH_WAIT_SECONDS=5

# --- HTTP API ---
# Порт API на хосте: http://localhost:8000/api
API_PORT=8000
# true — документация OpenAPI на /api/docs и /api/openapi.json.
API_DOCS=true
# Адрес, на котором слушает `uv run api` при локальном запуске без Docker.
API_HOST=0.0.0.0

# --- Поиск поставщиков ---
# Таймаут сценария поиска, секунды: дольше — ответ 504 search_timeout.
SEARCH_TIMEOUT_SECONDS=8
# Во сколько раз каналы поиска запрашивают больше кандидатов, чем лимит ответа.
SEARCH_RETRIEVAL_DEPTH=3
# Доля покрытых позиций, ниже которой кандидат получает статус check.
SEARCH_COVERAGE_THRESHOLD=0.5
# Сколько карточек лексический поиск отбирает из ClickHouse за запрос.
SEARCH_LEXICAL_POOL=500
# true — подключить канал поиска кандидатов по истории закупок.
SEARCH_HISTORY_ENABLED=true

# --- ML-сервис ---
# true — подключить ML-канал поиска кандидатов.
SEARCH_ML_ENABLED=false
ML_SERVICE_URL=http://search-api:8080
# Таймаут запроса к ML-сервису, секунды.
ML_SERVICE_TIMEOUT=6


# Загрузка CSV закупок (сервис api). 500 строк — проверенный предел одного файла;
# каждая закупка проходит общий поиск и сохраняется отдельным архивным результатом.
UPLOAD_MAX_BYTES=2097152
UPLOAD_MAX_ROWS=500
UPLOAD_CANDIDATES=20
UPLOAD_CONCURRENCY=2
UPLOAD_LOT_TIMEOUT_SECONDS=30
CLICKHOUSE_BACKGROUND_POOL_SIZE=2
