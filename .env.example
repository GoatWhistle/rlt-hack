# Переменные локального запуска через Docker Compose.
# Скопируйте файл в `.env` и меняйте значения под себя: `.env` в Git не попадает.
# Пустое значение означает «использовать значение по умолчанию из docker-compose.yml».

# --- Фронтенд ---
# Порт фронтенда на хосте.
WEB_PORT=8080
# Базовый URL API, подставляется при сборке.
VITE_API_BASE_URL=/api
# true — показывать демонстрационный результат без backend,
# false — отправлять файл в `POST {VITE_API_BASE_URL}/recommendations`.
VITE_DEMO_MODE=true

# --- ClickHouse ---
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.9
# Порты хранилища на хосте: HTTP и нативный протокол.
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=supplier_search
# true — подключаться к ClickHouse по TLS. Для локального запуска не нужно.
CLICKHOUSE_SECURE=false

# --- Веб-интерфейс ClickHouse ---
CLICKHOUSE_UI_IMAGE=ghcr.io/caioricciuti/ch-ui:v2.14.1
# Порт интерфейса на хосте: http://localhost:3488
CLICKHOUSE_UI_PORT=3488
# Адрес ClickHouse для интерфейса. Доступ передаётся внутри URL:
# у ch-ui нет отдельных переменных для пользователя и пароля.
CLICKHOUSE_UI_URL=http://${CLICKHOUSE_USER}:${CLICKHOUSE_PASSWORD}@clickhouse:8123

# --- Джоба сбора: источники ---
# Каждый адаптер включается своим флагом, обходятся только включённые.
# Адаптер исходного CSV: требует загруженных данных Git LFS в `task/data`.
# На рабочем компьютере данные не выгружаются, поэтому адаптер выключен.
SUPPLIER_DATASET_PROVIDER=false
# Фильтр по региону в исходном CSV, пусто — без фильтра.
SUPPLIER_DATASET_REGION=
# Путь к CSV поставщиков. Пусто — файл берётся из каталога данных задачи.
SUPPLIER_DATASET_PATH=
# YML-фиды магазинов: адреса через запятую, на каждый адрес — свой адаптер.
YML_FEED_PROVIDER=true
SUPPLIER_FEED_URLS=https://globalclimat.com/yandex.xml,https://sibrtex.ru/yandex.xml
# Сайты с разметкой schema.org: адреса через запятую, обход идёт по их sitemap.
SCHEMA_ORG_WEB_PROVIDER=true
SUPPLIER_SITE_URLS=https://kdom.ru,https://ninel-tex.ru,https://ateks-group.ru
# Каталоги компаний: адреса карточек адаптеры берут из sitemap источника.
OPTKATALOG_WEB_PROVIDER=true
ABOUTPARTNER_WEB_PROVIDER=true
TEXZAKAZ_WEB_PROVIDER=true
PULSCEN_WEB_PROVIDER=false
PULSCEN_DELAY_SECONDS=10
PULSCEN_SNAPSHOT_PATH=

# --- Джоба сбора: ограничения запуска ---
# Сколько источников обходится одновременно.
SYNC_PARALLEL_SOURCES=4
# Сколько запросов к одному источнику выполняет его адаптер одновременно.
SYNC_PARALLEL_REQUESTS=4
# Размер пачки записи в ClickHouse.
SYNC_WRITE_BATCH=500
# Сколько карточек берёт с одного источника один обход: каталоги публикуют тысячи.
SYNC_MAX_CARDS=500
# Пауза между циклами обхода в режиме демона.
SYNC_INTERVAL_SECONDS=3600
# Таймаут HTTP-запроса к источнику, секунды.
REQUEST_TIMEOUT=30
# DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
