[Unit]
Description=Qwen3 Embedding 4B on local GPU
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=rlt-deploy
Group=rlt-deploy
WorkingDirectory=/opt/rlt-hack/current/ml/serving/qwen4b
EnvironmentFile=/etc/rlt-hack/qwen4b.env
Environment=HF_HUB_OFFLINE=1
Environment=TOKENIZERS_PARALLELISM=false
ExecStart=/opt/rlt-hack/qwen4b/venv/bin/uvicorn api:app --host 172.18.0.1 --port 11436 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/rlt-hack/qwen4b/reports

[Install]
WantedBy=multi-user.target
